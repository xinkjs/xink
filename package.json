{
  "name": "xinkjs",
  "version": "0.0.0",
  "description": "monorepo for @xinkjs",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "@types/bun": "^1.4.0",
    "csstype": "^3.2.3",
    "husky": "^9.1.7",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "scripts": {
    "docs": "bun run --filter docs dev",
    "release": "bun run build && changeset publish --no-git-tag",
    "build": "tsc -b && bun run --filter xk build",
    "prepare": "npx is-ci || husky"
  },
  "workspaces": [
    "packages/*",
    "docs"
  ]
}
